## Terragrunt
# Working directory cache (created on every init/plan/apply)
.terragrunt-cache/

# Files generated by terragrunt.hcl generate{} blocks — recreated at runtime
backend.tf
versions.tf
provider.tf
locals.tf.json

## Terraform
# Terraform state — never commit
*.tfstate
*.tfstate.*
*.tfstate.backup

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform internals
.terraform/
# .terraform.lock.hcl  # uncomment to ignore; commit it to pin provider versions
crash.log
crash.*.log

# Sensitive variable files
*.tfvars
*.tfvars.json
!example.tfvars

## Secrets
# Per-machine env files (Cloudflare R2 keys, GitHub PATs, etc.) — NEVER commit.
.envrc.local
.env
.env.local

## Operating System Specific
# macOS
.DS_Store

## Nix
.direnv/
.pre-commit-config.yaml

## Tools
.serena/
.wrangler/
.omo/

## APM — generated; do not edit directly
apm_modules/
.codex/
.claude/
.opencode/
.mcp.json
opencode.json
AGENTS.md
CLAUDE.md
GEMINI.md
