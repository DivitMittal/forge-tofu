#!/usr/bin/env bash
set -euo pipefail

# usage: read-actions-secret <source-key> <secret-relative-path> [override-env-var]
# Prints the decrypted secret. When override-env-var is given and set to a
# non-empty value, that value wins and nothing is decrypted: Terragrunt
# evaluates both arms of an HCL conditional, so the override has to live here.
if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
  printf 'usage: %s <source-key> <secret-relative-path> [override-env-var]\n' "$0" >&2
  exit 64
fi

source_key="$1"
secret_path="$2"
override_var="${3:-}"
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Resolve the main checkout, not a linked worktree under .worktrees/, so the
# sibling secrets repo is found the same way from either.
main_root="$(dirname "$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || printf '%s/.git' "$repo_root")")"
secrets_repo="${FORGE_TOFU_SECRETS_REPO:-$(cd "$main_root/../../Cfgs/infra-nixCfg-secrets" 2>/dev/null && pwd || true)}"
placeholder_key="$(printf '%s' "$source_key" | tr '[:lower:]-' '[:upper:]_')"
placeholder="PLACEHOLDER__MISSING_SECRET__${placeholder_key}"
placeholder="${placeholder//[^A-Z0-9_]/_}"

fail() {
  printf '%s\n' "$1" >&2
  exit "${2:-1}"
}

case "$source_key" in
  *[!a-zA-Z0-9_-]* | '')
    fail "invalid secret source key: $source_key" 64
    ;;
esac

case "$secret_path" in
  /* | *..* | '' | *[!a-zA-Z0-9_./-]* )
    fail "invalid secret relative path for $source_key: $secret_path" 64
    ;;
esac

case "$override_var" in
  '') ;;
  *[!A-Z0-9_]* | [0-9]*)
    fail "invalid override variable name for $source_key: $override_var" 64
    ;;
  *)
    if [ -n "${!override_var:-}" ]; then
      printf '%s' "${!override_var}"
      exit 0
    fi
    ;;
esac

if [ "${FORGE_TOFU_PLACEHOLDER_SECRETS:-}" = "1" ]; then
  printf '%s' "$placeholder"
  exit 0
fi

if [ -z "$secrets_repo" ] || [ ! -d "$secrets_repo" ]; then
  fail "missing secrets repository for $source_key; set FORGE_TOFU_SECRETS_REPO" 66
fi

secret_file="$secrets_repo/secrets/$secret_path"
rules_file="$secrets_repo/secrets/manifest.nix"

if [ ! -f "$secret_file" ]; then
  fail "missing encrypted secret for $source_key: $secret_file" 66
fi

# agenix only looks in ~/.ssh/id_{ed25519,rsa} by default; the secrets repo's
# recipient key lives at ~/.ssh/agenix/id_ed25519.
identity="${FORGE_TOFU_AGE_IDENTITY:-$HOME/.ssh/agenix/id_ed25519}"
identity_args=()
if [ -f "$identity" ]; then
  identity_args=(--identity "$identity")
fi

if command -v agenix >/dev/null 2>&1; then
  cd "$secrets_repo/secrets" && RULES="$rules_file" agenix --decrypt "$secret_path" ${identity_args[@]+"${identity_args[@]}"}
  exit 0
fi

fail "missing agenix needed to decrypt $secret_path" 69
