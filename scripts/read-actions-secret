#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 2 ]; then
  printf 'usage: %s <source-key> <secret-relative-path>\n' "$0" >&2
  exit 64
fi

source_key="$1"
secret_path="$2"
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
secrets_repo="${GHORG_TERRAFORM_SECRETS_REPO:-$(cd "$repo_root/../../Cfgs/OS-nixCfg-secrets" 2>/dev/null && pwd || true)}"
placeholder_key="$(printf '%s' "$source_key" | tr '[:lower:]-' '[:upper:]_')"
placeholder="PLACEHOLDER__MISSING_SECRET__${placeholder_key}"
placeholder="${placeholder//[^A-Z0-9_]/_}"

fail() {
  printf '%s\n' "$1" >&2
  exit "${2:-1}"
}

case "$source_key" in
  *[!a-zA-Z0-9_-]* | '')
    fail "invalid secret source key: $source_key" 64
    ;;
esac

case "$secret_path" in
  /* | *..* | '' | *[!a-zA-Z0-9_./-]* )
    fail "invalid secret relative path for $source_key: $secret_path" 64
    ;;
esac

if [ "${GHORG_TERRAFORM_PLACEHOLDER_SECRETS:-}" = "1" ]; then
  printf '%s' "$placeholder"
  exit 0
fi

if [ -z "$secrets_repo" ] || [ ! -d "$secrets_repo" ]; then
  fail "missing secrets repository for $source_key; set GHORG_TERRAFORM_SECRETS_REPO" 66
fi

secret_file="$secrets_repo/secrets/$secret_path"
rules_file="$secrets_repo/secrets/manifest.nix"

if [ ! -f "$secret_file" ]; then
  fail "missing encrypted secret for $source_key: $secret_file" 66
fi

if command -v agenix >/dev/null 2>&1; then
  cd "$secrets_repo/secrets" && RULES="$rules_file" agenix --decrypt "$secret_path"
  exit 0
fi

fail "missing agenix needed to decrypt $secret_path" 69
