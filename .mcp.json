{
  "mcpServers": {
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "claude-code",
        "--project",
        "~/Projects/ghOrg-terraform/"
      ]
    },
    "terraform": {
      "type": "stdio",
      "command": "terraform-mcp-server",
      "args": [
        "stdio",
        "--toolsets=registry"
      ]
    }
  }
}
